<Window x:Class="DashForge.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DashForge" Height="720" Width="1100" MinHeight="600" MinWidth="900" WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}" Foreground="#F3F5F8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#0B0D11" Padding="20"><StackPanel><TextBlock Text="DASHFORGE" FontSize="24" FontWeight="Black" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,28"/><TextBlock Text="WORKSPACE" Foreground="#778291" Margin="0,0,0,10"/><Button Content="Home" Click="Home_Click"/><Button Content="Installations" Click="Installations_Click"/><Button Content="Profiles" Click="Profiles_Click"/><Button Content="Mods" Click="Mods_Click"/><Button Content="Backups" Click="Backups_Click"/><Button Content="Performance" Click="Performance_Click"/><Button Content="Diagnostics" Click="Diagnostics_Click"/><Button Content="News &amp; changelog" Click="News_Click"/><Button Content="Settings" Click="Settings_Click"/><TextBlock Text="0.1.0 · GAME VERSION UNVERIFIED" Foreground="#F4C36A" FontSize="10" Margin="0,35,0,0"/></StackPanel></Border><ScrollViewer Grid.Column="1"><StackPanel Margin="38"><TextBlock Text="LAUNCHER / OVERVIEW" Foreground="#8A95A5"/><TextBlock x:Name="PageTitle" Text="Your next attempt starts here." FontSize="28" FontWeight="Bold" Margin="0,8,0,25"/><Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="26"><StackPanel><TextBlock Text="READY WHEN YOU ARE" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/><TextBlock Text="Geometry Dash" FontSize="30" FontWeight="Bold" Margin="0,10"/><TextBlock x:Name="InstallationStatus" Text="No installation selected. Select GeometryDash.exe to begin." Foreground="#A8B1BF" TextWrapping="Wrap"/><WrapPanel Margin="0,18,0,0"><Button Content="SELECT GAME" Click="SelectGame_Click"/><Button x:Name="PlayButton" Content="PLAY" IsEnabled="False" Click="Play_Click"/></WrapPanel></StackPanel></Border><UniformGrid Columns="3" Margin="0,18"><Border Background="{StaticResource PanelBrush}" Padding="14" Margin="0,0,6,0"><StackPanel><TextBlock Text="INSTALLATION HEALTH" Foreground="#8A95A5"/><TextBlock Text="UNKNOWN" Foreground="#F4C36A" FontSize="18" Margin="0,8"/><TextBlock Text="No trusted manifest" Foreground="#A8B1BF"/></StackPanel></Border><Border Background="{StaticResource PanelBrush}" Padding="14" Margin="3,0"><StackPanel><TextBlock Text="ACTIVE PROFILE" Foreground="#8A95A5"/><TextBlock Text="Default" FontSize="18" Margin="0,8"/><TextBlock Text="Local launcher settings" Foreground="#A8B1BF"/></StackPanel></Border><Border Background="{StaticResource PanelBrush}" Padding="14" Margin="6,0,0,0"><StackPanel><TextBlock Text="MOD FRAMEWORK" Foreground="#8A95A5"/><TextBlock Text="NOT VERIFIED" Foreground="#F4C36A" FontSize="18" Margin="0,8"/><TextBlock Text="No compatibility claim" Foreground="#A8B1BF"/></StackPanel></Border></UniformGrid><Border Background="#151A22" CornerRadius="12" Padding="18"><StackPanel><TextBlock Text="PROJECT STATUS" FontWeight="Bold"/><TextBlock x:Name="StatusText" Text="Choose a legitimate installation to launch. Repair, mod installation, backups, and automatic updates are not yet available." Foreground="#A8B1BF" TextWrapping="Wrap" Margin="0,8"/></StackPanel></Border></StackPanel></ScrollViewer></Grid></Window>
